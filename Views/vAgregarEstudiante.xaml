<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="mnaupariS6.Views.vAgregarEstudiante"
    Title="Agregar Estudiante"
    BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <!-- Título -->
            <Label
                Text="SEMANA 6: AGREGAR ESTUDIANTE"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#263238"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,15,0,20"/>

            <!-- Nombre -->
            <Label
                Text="Nombre"
                FontAttributes="Bold"
                TextColor="#263238"/>

            <Entry
                x:Name="txtNombre"
                Placeholder="Ingresa el nombre"
                TextColor="#263238"/>

            <!-- Apellido -->
            <Label
                Text="Apellido"
                FontAttributes="Bold"
                TextColor="#263238"/>

            <Entry
                x:Name="txtApellido"
                Placeholder="Ingresa el apellido"
                TextColor="#263238"/>

            <!-- Edad -->
            <Label
                Text="Edad"
                FontAttributes="Bold"
                TextColor="#263238"/>

            <Entry
                x:Name="txtEdad"
                Placeholder="Ingresa la edad"
                Keyboard="Numeric"
                TextColor="#263238"/>

            <!-- Botones -->
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                Margin="0,20,0,0">

                <Button
                    x:Name="btnAgregar"
                    Grid.Column="0"
                    Text="Agregar"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="btnAgregar_Clicked"/>

                <Button
                    x:Name="btnCancelar"
                    Grid.Column="1"
                    Text="Cancelar"
                    BackgroundColor="#607D8B"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="btnCancelar_Clicked"/>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
